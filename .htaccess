Options -Indexes
DirectoryIndex public/index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never expose hidden files or Laravel's source/configuration directories.
    RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L,NC]
    RewriteRule ^(?:app|bootstrap|config|database|resources|routes|storage|vendor|tests|node_modules|\.git)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:artisan|composer\.(?:json|lock)|package(?:-lock)?\.json|bun\.lock|phpunit\.xml|vite\.config\.[^/]+|\.env(?:\..*)?)$ - [F,L,NC]

    # Serve public assets from Laravel's public/ directory.
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -d
    RewriteRule ^(.*)$ public/$1 [L]

    # Send all remaining requests to Laravel's front controller.
    RewriteRule ^ public/index.php [L]
</IfModule>
